<%- include('partials/header') %>
<main id="main">
  <section class="page-hero">
    <div class="container">
      
      <div class="page-intro">
        <p class="eyebrow">Explore opportunities</p>
        <h1><%= title %></h1>
        <p>Choose an area that matters to you and discover ways to contribute.</p>
      </div>
    </div>
  </section>
  <section class="container page-body">
    <div class="category-grid">
      <article class="category-card category-environmental">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Green forest and natural landscape" loading="lazy" decoding="async"></div>
        <div class="category-card-content"><span class="category-icon" aria-hidden="true">🌱</span><h2>Environmental</h2><p>Protect natural spaces, reduce waste, and support a healthier environment.</p></div>
      </article>
      <article class="category-card category-educational">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Students learning together in a classroom" loading="lazy" decoding="async"></div>
        <div class="category-card-content"><span class="category-icon" aria-hidden="true">📚</span><h2>Educational</h2><p>Encourage learning through tutoring, mentoring, and educational activities.</p></div>
      </article>
      <article class="category-card category-community">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Community volunteers working together" loading="lazy" decoding="async"></div>
        <div class="category-card-content"><span class="category-icon" aria-hidden="true">🤝</span><h2>Community Service</h2><p>Support neighbors and strengthen the places where people live.</p></div>
      </article>
      <article class="category-card category-health">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Person practicing mindfulness outdoors" loading="lazy" decoding="async"></div>
        <div class="category-card-content"><span class="category-icon" aria-hidden="true">💚</span><h2>Health and Wellness</h2><p>Promote well-being, healthy habits, and access to helpful resources.</p></div>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
