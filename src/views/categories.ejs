
<%- include('partials/header') %>

<main id="main">

  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><%= title %></span>
      </nav>
      <div class="page-intro">
        <p class="eyebrow">Explore opportunities</p>
        <h1><%= title %></h1>
        <p>Choose an area that matters to you and discover ways to contribute.</p>
      </div>
    </div>
  </section>

  <section class="container page-body">
    <div class="category-grid">
      <% categories.forEach(category => { %>
        <article class="category-card <%= category.css_class %>">
          <div class="card-media">
            <img class="card-image" src="/images/<%= category.image_filename %>" alt="<%= category.image_alt %>" loading="lazy" decoding="async" >
          </div>
          <div class="category-card-content">
            <span class="category-icon" aria-hidden="true"> <%= category.icon %> </span>
            <h2><%= category.name %></h2>
            <p><%= category.description %></p>
          </div>
        </article>
      <% }); %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
