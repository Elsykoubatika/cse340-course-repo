<%- include('partials/header') %>
<main class="container section">
  <div class="page-intro">
    <p class="eyebrow">Working together</p>
    <h1><%= title %></h1>
    <p>Meet community partners who help turn service into lasting impact.</p>
  </div>
  <div class="organization-grid">
    <article class="organization-card">
      <img class="card-image" src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Young people learning together" loading="lazy" decoding="async">
      <div class="organization-card-content"><img class="organization-logo" src="/images/brightfuture.svg" alt="Bright Future logo" loading="lazy"><div><h2>Bright Future</h2><p>Supports learning opportunities and educational resources for young people.</p></div></div>
    </article>
    <article class="organization-card">
      <img class="card-image" src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Plants growing in a community garden" loading="lazy" decoding="async">
      <div class="organization-card-content"><img class="organization-logo" src="/images/greenharvest.svg" alt="Green Harvest logo" loading="lazy"><div><h2>Green Harvest</h2><p>Promotes environmental awareness, clean-up activities, and community gardens.</p></div></div>
    </article>
    <article class="organization-card">
      <img class="card-image" src="https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Volunteers working together on a community project" loading="lazy" decoding="async">
      <div class="organization-card-content"><img class="organization-logo" src="/images/unityserve.svg" alt="Unity Serve logo" loading="lazy"><div><h2>Unity Serve</h2><p>Connects volunteers with practical projects that strengthen neighborhoods.</p></div></div>
    </article>
  </div>
</main>
<%- include('partials/footer') %>