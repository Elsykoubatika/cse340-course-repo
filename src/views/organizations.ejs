
<%- include('partials/header') %>

<main id="main">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><%= title %></span>
      </nav>

      <div class="page-intro">
        <p class="eyebrow">Working together</p>
        <h1><%= title %></h1>
        <p>Meet community partners who help turn service into lasting impact.</p>
      </div>
    </div>
  </section>

  <section class="container page-body">
    <div class="organization-grid">

      <% organizations.forEach(organization => { %>
        <article class="organization-card">
          <div class="card-media"><img class="card-image" src="/images/<%= organization.image_filename %>" alt="Plants growing in a community garden" loading="lazy" decoding="async"></div>
          <div class="organization-card-content">
            <img class="organization-logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %>" loading="lazy" decoding="async">
            <h2><%= organization.name %></h2>
            <p><%= organization.description %></p>
            <p><a href="mailto:<%= organization.contact_email %>"> <%= organization.contact_email %> </a> </p>
          </div>

        </article>
      <% }); %>

    </div>
  </section>
</main>

<%- include('partials/footer') %>