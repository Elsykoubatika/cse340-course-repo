<%- include('partials/header') %>
<main id="main">
  <section class="page-hero">
    <div class="container">
      <div class="page-intro">
        <p class="eyebrow">Working together</p>
        <h1><%= title %></h1>
        <p>Meet community partners who help turn service into lasting impact.</p>
      </div>
    </div>
  </section>
  <section class="container page-body">
    <div class="organization-grid">
      <article class="organization-card">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Young people learning together" loading="lazy" decoding="async"></div>
        <div class="organization-card-content">
          <img class="organization-logo" src="/images/brightfuture.svg" alt="Bright Future logo" loading="lazy">
          <h2>Bright Future</h2>
          <p>Supports learning opportunities and educational resources for young people.</p>
        </div>
      </article>
      <article class="organization-card">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Plants growing in a community garden" loading="lazy" decoding="async"></div>
        <div class="organization-card-content">
          <img class="organization-logo" src="/images/greenharvest.svg" alt="Green Harvest logo" loading="lazy">
          <h2>Green Harvest</h2>
          <p>Promotes environmental awareness, clean-up activities, and community gardens.</p>
        </div>
      </article>
      <article class="organization-card">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Volunteers working together on a community project" loading="lazy" decoding="async"></div>
        <div class="organization-card-content">
          <img class="organization-logo" src="/images/unityserve.svg" alt="Unity Serve logo" loading="lazy">
          <h2>Unity Serve</h2>
          <p>Connects volunteers with practical projects that strengthen neighborhoods.</p>
        </div>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
