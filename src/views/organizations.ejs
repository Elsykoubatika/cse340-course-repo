<%- include('partials/header') %>
<main id="main">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page"><%= title %></span></nav>
      <div class="page-intro">
        <p class="eyebrow">Working together</p>
        <h1><%= title %></h1>
        <p>Meet community partners who help turn service into lasting impact.</p>
      </div>
    </div>
  </section>
  <section class="container page-body">
    <div class="organization-grid">
      <article class="organization-card">
        <div class="card-media"><img class="card-image" src="/images/education.svg" alt="Young people learning together" loading="lazy" decoding="async"></div>
        <div class="organization-card-content">
          <img class="organization-logo" src="/images/brightfuture.svg" alt="Bright Future logo" loading="lazy">
          <h2>Bright Future</h2>
          <p>Supports learning opportunities and educational resources for young people.</p>
        </div>
      </article>
      <article class="organization-card">
        <div class="card-media"><img class="card-image" src="/images/garden.svg" alt="Plants growing in a community garden" loading="lazy" decoding="async"></div>
        <div class="organization-card-content">
          <img class="organization-logo" src="/images/greenharvest.svg" alt="Green Harvest logo" loading="lazy">
          <h2>Green Harvest</h2>
          <p>Promotes environmental awareness, clean-up activities, and community gardens.</p>
        </div>
      </article>
      <article class="organization-card">
        <div class="card-media"><img class="card-image" src="/images/community.svg" alt="Volunteers working together on a community project" loading="lazy" decoding="async"></div>
        <div class="organization-card-content">
          <img class="organization-logo" src="/images/unityserve.svg" alt="Unity Serve logo" loading="lazy">
          <h2>Unity Serve</h2>
          <p>Connects volunteers with practical projects that strengthen neighborhoods.</p>
        </div>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
