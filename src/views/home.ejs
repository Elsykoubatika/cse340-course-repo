<%- include('partials/header') %>
<main id="main">
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-copy-block">
        <p class="eyebrow">Community service network</p>
        <h1 class="hero-heading">Make a difference in your community</h1>
        <p class="hero-copy">Discover local opportunities, meet organizations doing meaningful work, and turn your time and talents into positive community impact.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/projects">Explore projects</a>
          <a class="button button-secondary" href="/organizations">Meet our partners</a>
        </div>
      </div>
      <div class="hero-media">
        <img class="hero-image" src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Volunteers spending time together outdoors" fetchpriority="high">
      </div>
    </div>
  </section>

  <section class="container stats" aria-label="Network at a glance">
    <div class="stats-card">
      <div class="stat"><strong>1</strong><span>Partner<br>organizations</span></div>
      <div class="stat"><strong>2</strong><span>Service<br>categories</span></div>
      <div class="stat"><strong>3</strong><span>Featured<br>projects</span></div>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <p class="eyebrow">How it works</p>
      <h2>Find your way to make a difference</h2>
      <p>Start with an interest, discover a project, and connect with a partner organization.</p>
    </div>
    <div class="feature-grid">
      <article class="feature-card"><span class="feature-number">01</span><h3>Explore categories</h3><p>Browse environmental, educational, community, and wellness initiatives.</p><a href="/categories">View categories <span aria-hidden="true">→</span></a></article>
      <article class="feature-card"><span class="feature-number">02</span><h3>Discover projects</h3><p>Find service activities where your skills and availability can help.</p><a href="/projects">View projects <span aria-hidden="true">→</span></a></article>
      <article class="feature-card"><span class="feature-number">03</span><h3>Meet organizations</h3><p>Learn about community partners and the work they support.</p><a href="/organizations">View organizations <span aria-hidden="true">→</span></a></article>
    </div>
  </section>

  <section class="container cta">
    <div class="cta-card">
      <div>
        <h2>Ready to get involved?</h2>
        <p>Browse the latest service opportunities and find the one that fits you.</p>
      </div>
      <a class="button button-primary" href="/projects">Explore projects</a>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
