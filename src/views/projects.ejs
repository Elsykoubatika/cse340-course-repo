<%- include('partials/header') %>
<main id="main">
  <section class="page-hero">
    <div class="container">
    
      <div class="page-intro">
        <p class="eyebrow">Take action</p>
        <h1><%= title %></h1>
        <p>These sample opportunities show the kinds of projects volunteers can explore.</p>
      </div>
    </div>
  </section>
  <section class="container page-body">
    <div class="project-grid">
      <article class="project-card">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1618477461853-cf6ed80faba5?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Volunteers cleaning up an outdoor space" loading="lazy" decoding="async"></div>
        <div class="project-card-content">
          <span class="tag">Environmental</span>
          <h2>Neighborhood Clean-up</h2>
          <p>Help collect litter and make shared public spaces cleaner and safer.</p>
          <p class="project-meta">Sample opportunity · Community</p>
        </div>
      </article>
      <article class="project-card">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="A student reading and learning with support" loading="lazy" decoding="async"></div>
        <div class="project-card-content">
          <span class="tag">Educational</span>
          <h2>Reading Support</h2>
          <p>Support learners with reading practice, homework, and study skills.</p>
          <p class="project-meta">Sample opportunity · Education</p>
        </div>
      </article>
      <article class="project-card">
        <div class="card-media"><img class="card-image" src="https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&amp;fit=crop&amp;w=900&amp;q=85" alt="Food and supplies prepared for community distribution" loading="lazy" decoding="async"></div>
        <div class="project-card-content">
          <span class="tag">Community Service</span>
          <h2>Community Food Drive</h2>
          <p>Help organize, sort, and distribute donated food to local families.</p>
          <p class="project-meta">Sample opportunity · Outreach</p>
        </div>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
