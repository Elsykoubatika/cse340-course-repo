<%- include('partials/header') %>
<main id="main">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page"><%= title %></span></nav>
      <div class="page-intro">
        <p class="eyebrow">Take action</p>
        <h1><%= title %></h1>
        <p>These sample opportunities show the kinds of projects volunteers can explore.</p>
      </div>
    </div>
  </section>
  <section class="container page-body">
    <div class="project-grid">
      <article class="project-card">
        <div class="card-media"><img class="card-image" src="/images/green-harvest-garden.png" alt="Volunteers cleaning up an outdoor space" loading="lazy" decoding="async"></div>
        <div class="project-card-content">
          <span class="tag">Environmental</span>
          <h2>Neighborhood Clean-up</h2>
          <p>Help collect litter and make shared public spaces cleaner and safer.</p>
          <p class="project-meta">Sample opportunity · Community</p>
        </div>
      </article>
      <article class="project-card">
        <div class="card-media"><img class="card-image" src="/images/reading-support.png" alt="A student reading and learning with support" loading="lazy" decoding="async"></div>
        <div class="project-card-content">
          <span class="tag">Educational</span>
          <h2>Reading Support</h2>
          <p>Support learners with reading practice, homework, and study skills.</p>
          <p class="project-meta">Sample opportunity · Education</p>
        </div>
      </article>
      <article class="project-card">
        <div class="card-media"><img class="card-image" src="/images/community-service.png" alt="Food and supplies prepared for community distribution" loading="lazy" decoding="async"></div>
        <div class="project-card-content">
          <span class="tag">Community Service</span>
          <h2>Community Food Drive</h2>
          <p>Help organize, sort, and distribute donated food to local families.</p>
          <p class="project-meta">Sample opportunity · Outreach</p>
        </div>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
